NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PHONE=(604) 000-0000
NEXT_PUBLIC_EMAIL=info@northpeakjunk.com
# Social profiles. Instagram and X already have live accounts and their URLs
# are the defaults in src/content/site.ts — leave these blank unless a handle
# changes. Facebook and LinkedIn have no account yet; blank keeps them out of
# both the footer and the `sameAs` in the structured data.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Google Business Profile. Both are optional: unset, the site omits the links
# rather than rendering dead ones, and the profile is left out of `sameAs`.
# REVIEW_URL is the short link from the profile dashboard's "Ask for reviews"
# panel — it opens the review form directly, which is the whole point.
# PROFILE_URL is the public listing. See docs/local-seo-playbook.md.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_GOOGLE_PROFILE_URL=

# Google Analytics 4 measurement ID. Leave blank to disable analytics entirely
# (local development, preview deploys); set it in production only.
NEXT_PUBLIC_GA_ID=G-SGXXEX8N1Z

# Server-only — estimate lead delivery (never expose via NEXT_PUBLIC_*)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Server-only — lead webhook (never expose via NEXT_PUBLIC_*)
# Google Apps Script /exec URL that files leads into the owner's Sheet; see
# automation/google-apps-script/SETUP.md. Leave blank to disable: submissions
# still work exactly as before and nothing is posted anywhere.
LEAD_WEBHOOK_URL=

# Server-only — PEAK AI assistant (never expose via NEXT_PUBLIC_*)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Phase 2 — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — NorthPeak Ops, the internal panel at /admin
# Without the first two, /admin renders a setup screen listing what is missing
# rather than crashing. The marketing site needs none of them.
#
# Neon serverless Postgres. Apply drizzle/0000_northpeak_ops.sql to the branch
# first with `npm run db:push`.
DATABASE_URL=
# Shared login password for the two-person team. Also derives the key that
# signs the session cookie, so changing it signs everyone out.
ADMIN_PASSWORD=
# Optional. Enables the photo-assist box on New Quote; without it the catalog
# picker works on its own and the box is hidden.
ANTHROPIC_API_KEY=
# Optional. Overrides the vision model without a redeploy.
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
